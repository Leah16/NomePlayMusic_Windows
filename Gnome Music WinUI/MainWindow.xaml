<Window
    x:Class="Gnome_Music_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    xmlns:h="using:Gnome_Music_WinUI.Helpers"
    Title="Music">

    <!-- Window.ui: toolbar view with the header bar, the navigation view with the
         toast overlay, and the player toolbar at the bottom.
         Fluent surfaces: no Mica. The window is opaque, on the base fill, and each
         layer above it is a lighter solid fill (Styles.xaml). Only the title bar is
         acrylic (SystemBackdropElement below). -->
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header bar (HeaderBar.ui / SearchHeaderBar.ui / pushed pages): a custom
             title bar with icons only; drag and passthrough regions are set up in code -->
        <Grid x:Name="AppTitleBar" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionColumn" Width="138" />
            </Grid.ColumnDefinitions>

            <!-- Acrylic behind the title bar only, caption buttons included -->
            <SystemBackdropElement Grid.ColumnSpan="5">
                <SystemBackdropElement.SystemBackdrop>
                    <DesktopAcrylicBackdrop />
                </SystemBackdropElement.SystemBackdrop>
            </SystemBackdropElement>

            <!-- Back (go-previous-symbolic), global: out of pushed pages, search and back
                 to the views shown before; there only while it leads somewhere, never on
                 the status page nor over the lyrics -->
            <Button
                x:Name="BackButton"
                Margin="6,0,0,0"
                AutomationProperties.Name="{x:Bind h:Strings.Back}"
                Click="OnBackClick"
                Style="{StaticResource TitleBarButtonStyle}"
                ToolTipService.ToolTip="{x:Bind h:Strings.Back}">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>

            <!-- Title widget, centred in the whole bar -->
            <Grid
                x:Name="TitleContent"
                Grid.ColumnSpan="5"
                HorizontalAlignment="Center">
                <!-- AdwViewSwitcher, icons only; the names are tooltips -->
                <SelectorBar
                    x:Name="ViewSwitcher"
                    HorizontalAlignment="Center"
                    IsTabStop="False"
                    SelectionChanged="OnViewSwitcherSelectionChanged">
                    <SelectorBarItem
                        x:Name="AlbumsItem"
                        AutomationProperties.Name="{x:Bind h:Strings.Albums}"
                        Tag="albums"
                        Tapped="OnViewItemTapped"
                        ToolTipService.ToolTip="{x:Bind h:Strings.Albums}">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE93C;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem
                        x:Name="ArtistsItem"
                        AutomationProperties.Name="{x:Bind h:Strings.Artists}"
                        Tag="artists"
                        Tapped="OnViewItemTapped"
                        ToolTipService.ToolTip="{x:Bind h:Strings.Artists}">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE77B;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem
                        x:Name="PlaylistsItem"
                        AutomationProperties.Name="{x:Bind h:Strings.Playlists}"
                        Tag="playlists"
                        Tapped="OnViewItemTapped"
                        ToolTipService.ToolTip="{x:Bind h:Strings.Playlists}">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE8FD;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>

                <!-- GtkSearchEntry: width 500, centred -->
                <Border
                    x:Name="SearchEntryBorder"
                    Width="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="SearchEntry"
                        AutomationProperties.Name="{x:Bind h:Strings.Search}"
                        KeyDown="OnSearchEntryKeyDown"
                        PlaceholderText="{x:Bind h:Strings.SearchPlaceholder}"
                        TextChanged="OnSearchTextChanged" />
                </Border>
            </Grid>

            <!-- Search, next to the preferences -->
            <ToggleButton
                x:Name="SearchButton"
                Grid.Column="2"
                Margin="0,0,4,0"
                AutomationProperties.Name="{x:Bind h:Strings.Search}"
                Click="OnSearchButtonClick"
                Style="{StaticResource TitleBarToggleButtonStyle}"
                ToolTipService.ToolTip="{x:Bind h:Strings.Search}">
                <ToggleButton.Resources>
                    <!-- Unchecked it looks like the other (subtle) title bar buttons;
                         checked it keeps the toggle button's accent fill -->
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <SolidColorBrush x:Key="ToggleButtonBackground" Color="{ThemeResource SubtleFillColorTransparent}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="{ThemeResource SubtleFillColorTransparent}" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="ToggleButtonBackground" Color="{ThemeResource SubtleFillColorTransparent}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="{ThemeResource SubtleFillColorTransparent}" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                            </ResourceDictionary>
                            <!-- "Default" would also be used for high contrast: keep the system colors -->
                            <ResourceDictionary x:Key="HighContrast">
                                <SolidColorBrush x:Key="ToggleButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </ToggleButton.Resources>
                <FontIcon FontSize="16" Glyph="&#xE721;" />
            </ToggleButton>

            <!-- The preferences, where GNOME Music has its primary menu: a view like the
                 albums, artists and playlists (the keyboard shortcuts and About with the
                 help are in it), so its own switcher shows it selected as theirs does -->
            <SelectorBar
                x:Name="PreferencesSwitcher"
                Grid.Column="3"
                Margin="0,0,6,0"
                IsTabStop="False"
                SelectionChanged="OnPreferencesSwitcherSelectionChanged">
                <!-- As wide as the menu button was: nothing in the bar moves. Not a tab
                     stop: a selector bar selects the item that gets the keyboard focus,
                     and with an empty library (no view switcher, search disabled) the
                     window's first focus, or the focus leaving the view switcher, landed
                     here and opened the preferences over the welcome page, again and
                     again. The keyboard has Ctrl+, instead. -->
                <SelectorBarItem
                    x:Name="PreferencesItem"
                    Width="36"
                    MinWidth="0"
                    AutomationProperties.Name="{x:Bind h:Strings.Preferences}"
                    IsTabStop="False"
                    Tag="preferences"
                    Tapped="OnPreferencesItemTapped"
                    ToolTipService.ToolTip="{x:Bind h:Strings.Preferences}">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE700;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
        </Grid>

        <!-- AdwNavigationView. Each page draws its own content layer, so sidebars can
             stay on the base. -->
        <Frame
            x:Name="NavFrame"
            Grid.Row="1"
            Background="Transparent"
            Navigated="OnNavigated" />

        <!-- The lyrics (not in GNOME Music): one white page over the whole window, below
             the player bar. There is no title bar over it: the lines start below its
             height (the padding) and scroll up to the top edge, under the caption
             buttons, though that band still drags the window. While the pointer rests,
             the player bar and the caption buttons step aside and the lines show down to
             the bottom. -->
        <controls:LyricsView
            x:Name="Lyrics"
            Grid.RowSpan="3"
            Padding="0,48,0,0" />

        <!-- Over the lyrics, where the title bar's back button is: back out of them. It
             steps aside with the player bar and the caption buttons. -->
        <Button
            x:Name="LyricsBackButton"
            Margin="6,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind h:Strings.Back}"
            Click="OnLyricsBackClick"
            Style="{StaticResource TitleBarButtonStyle}"
            ToolTipService.ToolTip="{x:Bind h:Strings.Back}"
            Visibility="Collapsed">
            <Button.OpacityTransition>
                <ScalarTransition />
            </Button.OpacityTransition>
            <FontIcon FontSize="16" Glyph="&#xE72B;" />
        </Button>

        <!-- AdwToastOverlay: above the player bar -->
        <controls:ToastOverlay x:Name="Toasts" Grid.Row="1" />

        <!-- PlayerToolbar (bottom bar) -->
        <controls:PlayerToolbar x:Name="PlayerBar" Grid.Row="2" />
    </Grid>
</Window>
