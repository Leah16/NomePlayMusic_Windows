<ContentDialog
    x:Class="Gnome_Music_WinUI.Dialogs.PlaylistDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Gnome_Music_WinUI.Helpers"
    xmlns:models="using:Gnome_Music_WinUI.Models"
    Title="{x:Bind h:Strings.AddToPlaylist}"
    CloseButtonText="{x:Bind h:Strings.Cancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnAddClick"
    PrimaryButtonText="{x:Bind h:Strings.Add}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <!-- PlaylistDialog.ui -->
    <Grid Width="400" Height="400">
        <!-- _empty_box: no user playlist yet -->
        <StackPanel
            x:Name="EmptyBox"
            Margin="18"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <FontIcon
                Margin="0,0,0,16"
                FontSize="100"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE8D6;" />
            <TextBlock
                HorizontalAlignment="Center"
                HorizontalTextAlignment="Center"
                Text="{x:Bind h:Strings.FirstPlaylistPrompt}"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="FirstPlaylistEntry"
                Width="300"
                Margin="18,18,18,16"
                HorizontalAlignment="Center"
                KeyDown="OnFirstEntryKeyDown"
                TextChanged="OnFirstEntryTextChanged" />
            <Button
                x:Name="CreateButton"
                MinWidth="120"
                Margin="0,10,0,20"
                HorizontalAlignment="Center"
                Click="OnCreateClick"
                Content="{x:Bind h:Strings.Create}"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <!-- _normal_box: the user playlists and a new playlist entry -->
        <Grid x:Name="NormalBox" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="PlaylistsList"
                SelectionChanged="OnPlaylistSelected"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:UserPlaylist">
                        <TextBlock
                            Margin="0,8"
                            Style="{StaticResource BodyLabelStyle}"
                            Text="{x:Bind Title}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="NewPlaylistEntry"
                    CornerRadius="4,0,0,4"
                    GotFocus="OnNewEntryFocused"
                    KeyDown="OnNewEntryKeyDown"
                    PlaceholderText="{x:Bind h:Strings.NewPlaylistEllipsis}"
                    TextChanged="OnNewEntryTextChanged" />
                <Button
                    x:Name="NewPlaylistButton"
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Click="OnNewPlaylistClick"
                    Content="{x:Bind h:Strings.Add}"
                    CornerRadius="0,4,4,0"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
