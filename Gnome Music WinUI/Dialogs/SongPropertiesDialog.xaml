<ContentDialog
    x:Class="Gnome_Music_WinUI.Dialogs.SongPropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Gnome_Music_WinUI.Helpers"
    CloseButtonText="{x:Bind h:Strings.Close}"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <!-- Room for the two panes; the code fits them to the window -->
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>

        <!-- Lines of lyrics in a card: selectable, synced ones after their times -->
        <Style x:Key="LyricsTextStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="14,10,14,12" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ContentDialog.Resources>

    <!-- Like the preferences: the pages on the left, the selected one on the right.
         The properties and the tags are read only; their values can be selected and
         copied. The lyrics page marks the song as instrumental, opens its lyrics file
         in another app and searches LRCLIB for other lyrics. -->
    <Grid x:Name="Root" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView
            x:Name="Categories"
            AutomationProperties.Name="{x:Bind h:Strings.Properties}"
            SelectionChanged="OnCategoryChanged"
            SelectionMode="Single">
            <ListViewItem>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon FontSize="16" Glyph="&#xE946;" />
                    <TextBlock Text="{x:Bind h:Strings.Properties}" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon FontSize="16" Glyph="&#xE8EC;" />
                    <TextBlock Text="{x:Bind h:Strings.Tags}" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem x:Name="LyricsCategory">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon FontSize="16" Glyph="&#xE90B;" />
                    <TextBlock Text="{x:Bind h:Strings.Lyrics}" />
                </StackPanel>
            </ListViewItem>
        </ListView>

        <ScrollViewer
            x:Name="PageScroller"
            Grid.Column="1"
            Padding="0,0,14,0"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="PropertiesPage" />
                <StackPanel x:Name="TagsPage" Visibility="Collapsed" />
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="32"
                    Height="32"
                    Margin="0,48,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsActive="True" />
            </Grid>
        </ScrollViewer>

        <!-- Lyrics: not in the page scroller, the lines and the search results scroll
             in their cards while the switch and the buttons stay -->
        <Grid
            x:Name="LyricsPage"
            Grid.Column="1"
            Margin="0,0,14,0"
            Visibility="Collapsed">

            <!-- Without the lyrics, local lyrics and downloads all on, nothing here works:
                 what to turn on, and the way there -->
            <StackPanel
                x:Name="LyricsUnavailable"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE90B;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource StrongLabelStyle}"
                    Text="{x:Bind h:Strings.LyricsSettingsRequired}"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SecondaryLabelStyle}"
                    Text="{x:Bind h:Strings.LyricsSettingsRequiredDetail}"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Click="OnOpenLyricsSettingsClick"
                    Content="{x:Bind h:Strings.OpenPreferences}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <!-- The song's lyrics, where they come from, and what can be done with them -->
            <Grid x:Name="LyricsMain" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Grid
                        MinHeight="56"
                        Padding="14,10"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind h:Strings.SetInstrumental}" />
                            <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="{x:Bind h:Strings.SetInstrumentalDescription}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="InstrumentalSwitch"
                            Grid.Column="1"
                            AutomationProperties.Name="{x:Bind h:Strings.SetInstrumental}"
                            Style="{StaticResource RowSwitchStyle}"
                            Toggled="OnInstrumentalToggled" />
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource StrongLabelStyle}"
                        Text="{x:Bind h:Strings.Lyrics}" />

                    <!-- Editing is left to another app, and needs the lyrics in a file -->
                    <Grid Grid.Column="1">
                        <SplitButton
                            x:Name="EditButton"
                            AutomationProperties.Name="{x:Bind h:Strings.EditLyrics}"
                            Click="OnEditClick"
                            IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                <TextBlock Text="{x:Bind h:Strings.EditLyrics}" />
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Click="OnEditWithClick" Text="{x:Bind h:Strings.EditLyricsWith}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <!-- A disabled button takes no pointer, so shows no tooltip: this
                             layer over it says why it is disabled -->
                        <Border
                            x:Name="EditButtonHint"
                            Background="Transparent"
                            ToolTipService.ToolTip="{x:Bind h:Strings.EditLyricsUnavailable}"
                            Visibility="Collapsed" />
                    </Grid>
                    <Button
                        x:Name="SearchButton"
                        Grid.Column="2"
                        Click="OnSearchClick"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE721;" />
                            <TextBlock Text="{x:Bind h:Strings.SearchLyricsOnline}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Where the lyrics come from, and a lyrics file that is not read -->
                <StackPanel
                    x:Name="LyricsInfo"
                    Grid.Row="2"
                    Spacing="2" />

                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <Grid>
                        <ScrollViewer x:Name="LyricsScroller">
                            <StackPanel>
                                <TextBlock
                                    x:Name="LyricsText"
                                    Style="{StaticResource LyricsTextStyle}"
                                    Typography.NumeralAlignment="Tabular" />
                                <StackPanel
                                    x:Name="LyricsMessage"
                                    Margin="14,0,14,12"
                                    Spacing="4"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="LyricsMessageText"
                                        Style="{StaticResource SecondaryLabelStyle}"
                                        TextWrapping="Wrap" />
                                    <HyperlinkButton
                                        x:Name="RetryButton"
                                        Padding="0,2"
                                        Click="OnRetryClick"
                                        Content="{x:Bind h:Strings.Retry}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <ProgressRing
                            x:Name="LyricsRing"
                            Width="32"
                            Height="32"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Searching LRCLIB: what for, the results, the lyrics of the selected one -->
            <Grid
                x:Name="SearchPanel"
                RowSpacing="12"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button
                        x:Name="SearchBackButton"
                        AutomationProperties.Name="{x:Bind h:Strings.Back}"
                        Click="OnSearchBackClick"
                        Style="{StaticResource SubtleIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind h:Strings.Back}">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource StrongLabelStyle}"
                        Text="{x:Bind h:Strings.SearchLyricsTitle}" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SearchTitleBox"
                        Header="{x:Bind h:Strings.SearchSongTitle}"
                        KeyDown="OnSearchBoxKeyDown" />
                    <TextBox
                        x:Name="SearchArtistBox"
                        Grid.Column="1"
                        Header="{x:Bind h:Strings.SearchArtistName}"
                        KeyDown="OnSearchBoxKeyDown" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Click="OnRunSearchClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE721;" />
                            <TextBlock Text="{x:Bind h:Strings.Search}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Side by side, or one above the other when narrow -->
                <Grid
                    x:Name="ResultsArea"
                    Grid.Row="2"
                    ColumnSpacing="12"
                    SizeChanged="OnResultsAreaSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ResultsColumn" Width="240" />
                        <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ResultsRow" Height="*" />
                        <RowDefinition x:Name="PreviewRow" Height="0" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <ListView
                                x:Name="ResultsList"
                                Padding="0,4"
                                AutomationProperties.Name="{x:Bind h:Strings.SearchLyricsTitle}"
                                SelectionChanged="OnResultSelected"
                                SelectionMode="Single" />
                            <ProgressRing
                                x:Name="SearchRing"
                                Width="32"
                                Height="32"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="SearchMessage"
                                Margin="14,10"
                                Style="{StaticResource SecondaryLabelStyle}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="PreviewCard"
                        Grid.Column="1"
                        Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                x:Name="PreviewHeader"
                                Padding="14,10,14,0"
                                Spacing="2">
                                <TextBlock
                                    x:Name="PreviewTitle"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource StrongLabelStyle}" />
                                <TextBlock x:Name="PreviewDetails" Style="{StaticResource SecondaryCaptionLabelStyle}" />
                            </StackPanel>
                            <ScrollViewer x:Name="PreviewScroller" Grid.Row="1">
                                <TextBlock
                                    x:Name="PreviewText"
                                    Style="{StaticResource LyricsTextStyle}"
                                    Typography.NumeralAlignment="Tabular" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="DownloadButton"
                        Click="OnDownloadClick"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                            <TextBlock x:Name="DownloadText" Text="{x:Bind h:Strings.DownloadToLocal}" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="DownloadStatus"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource RowDescriptionStyle}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
