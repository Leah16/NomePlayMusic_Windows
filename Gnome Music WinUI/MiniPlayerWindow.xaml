<Window
    x:Class="Gnome_Music_WinUI.MiniPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Gnome_Music_WinUI.Helpers">

    <!-- The mini player (not in GNOME Music), after the Windows media player's: the
         cover fills the window. Pointing at it shows the controls over a blurred, dimmed
         copy of the cover, which is always dark, hence the dark theme. -->
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        PointerCaptureLost="OnRootPointerCaptureLost"
        PointerEntered="OnRootPointerEntered"
        PointerExited="OnRootPointerExited"
        PointerMoved="OnRootPointerMoved"
        PointerPressed="OnRootPointerPressed"
        PointerReleased="OnRootPointerReleased"
        RequestedTheme="Dark">

        <FontIcon
            x:Name="Placeholder"
            FontSize="64"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        <Image x:Name="ArtImage" Stretch="UniformToFill" />

        <Grid x:Name="Overlay" Opacity="0">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Grid.OpacityTransition>

            <Image x:Name="BlurImage" Stretch="UniformToFill" />
            <!-- Dims any cover enough for the white glyphs and text -->
            <Border Background="Black" Opacity="0.4" />

            <!-- The thin transport glyphs of Segoe MDL2 Assets, like the media player's -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="PreviousButton"
                    Width="48"
                    Height="48"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind h:Strings.Previous}"
                    Click="OnPreviousClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind h:Strings.Previous}">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="18"
                        Glyph="&#xE892;" />
                </Button>
                <Button
                    x:Name="PlayButton"
                    Width="48"
                    Height="48"
                    Padding="0"
                    Click="OnPlayClick"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon
                        x:Name="PlayIcon"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="28"
                        Glyph="&#xE768;" />
                </Button>
                <Button
                    x:Name="NextButton"
                    Width="48"
                    Height="48"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind h:Strings.Next}"
                    Click="OnNextClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind h:Strings.Next}">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="18"
                        Glyph="&#xE893;" />
                </Button>
            </StackPanel>

            <StackPanel
                Margin="16,0,16,40"
                VerticalAlignment="Bottom"
                Spacing="4">
                <TextBlock
                    x:Name="TitleText"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="ArtistText"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>

            <Button
                x:Name="FullViewButton"
                Width="32"
                Height="32"
                Margin="0,0,8,8"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="{x:Bind h:Strings.BackToFullView}"
                Click="OnFullViewClick"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="{x:Bind h:Strings.BackToFullView}">
                <!-- A picture in a window (drawn: no icon font has it) -->
                <PathIcon Data="F0 M0,0 H20 V13 H0 Z M1,1 V12 H19 V1 Z M8,4.5 H18 V11 H8 Z M9,5.5 V10 H17 V5.5 Z M9.5,10 L11.5,7.5 L13.5,10 Z M14.5,7 A0.8,0.8 0 1 1 16.1,7 A0.8,0.8 0 1 1 14.5,7 Z" />
            </Button>
        </Grid>

        <!-- The progress along the bottom edge -->
        <Grid Height="4" VerticalAlignment="Bottom">
            <Rectangle Fill="White" Opacity="0.3" />
            <Rectangle Fill="White" RenderTransformOrigin="0,0">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </Grid>
</Window>
