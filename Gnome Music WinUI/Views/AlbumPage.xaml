<Page
    x:Class="Gnome_Music_WinUI.Views.AlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    Background="Transparent">

    <!-- AlbumNavigationPage.ui: scrolled AlbumWidget -->
    <Border Style="{StaticResource ContentLayerStyle}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <controls:Clamp Margin="12,0" MaximumSize="1000">
                <controls:AlbumWidget x:Name="AlbumView" />
            </controls:Clamp>
        </ScrollViewer>
    </Border>
</Page>
