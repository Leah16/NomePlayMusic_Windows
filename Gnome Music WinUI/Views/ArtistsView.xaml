<UserControl
    x:Class="Gnome_Music_WinUI.Views.ArtistsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    xmlns:h="using:Gnome_Music_WinUI.Helpers"
    xmlns:models="using:Gnome_Music_WinUI.Models">

    <!-- ArtistsView.ui: AdwOverlaySplitView, sidebar of artists and the albums pane -->
    <Grid x:Name="Root" SizeChanged="OnSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The sidebar stays on the window's base -->
        <ListView
            x:Name="ArtistsList"
            Padding="6,6,6,4"
            AutomationProperties.Name="{x:Bind h:Strings.Artists}"
            Background="Transparent"
            ItemContainerStyle="{StaticResource SidebarItemStyle}"
            ItemsSource="{x:Bind Model.Artists, Mode=OneWay}"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:CoreArtist">
                    <controls:ArtistTile Artist="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Column="1" Style="{StaticResource SplitContentLayerStyle}">
            <controls:ArtistAlbumsWidget x:Name="AlbumsPane" />
        </Border>
    </Grid>
</UserControl>
