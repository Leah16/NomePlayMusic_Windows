<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-2.0-or-later -->
<UserControl
    x:Class="Gnome_Music_WinUI.Views.PreferencesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Gnome_Music_WinUI.Helpers">

    <UserControl.Resources>
        <!-- AdwPreferencesGroup: a heading and a card of rows -->
        <Style x:Key="GroupTitleStyle" BasedOn="{StaticResource StrongLabelStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
        <Style x:Key="FirstGroupTitleStyle" BasedOn="{StaticResource StrongLabelStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="GroupCardStyle" BasedOn="{StaticResource CardStyle}" TargetType="Border" />
        <Style x:Key="RowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>
        <Style x:Key="InfoRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <!-- A setting that belongs to the row above it: indented, like its dividers -->
        <Style x:Key="SubRowStyle" BasedOn="{StaticResource RowStyle}" TargetType="Grid">
            <Setter Property="Padding" Value="42,10,14,10" />
        </Style>
        <Style x:Key="SubRowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="42,0,0,0" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <!-- The categories: small icons, so ListViewItem's own inset (as in the song
             properties) keeps the selection pill clear of them; the artists' and
             playlists' sidebars start their 36 px tiles closer -->
        <Style x:Key="CategoryItemStyle" BasedOn="{StaticResource SidebarItemStyle}" TargetType="ListViewItem">
            <Setter Property="Padding" Value="16,0,12,0" />
        </Style>
    </UserControl.Resources>

    <!-- A view like the albums, artists and playlists (not a dialog): the categories in
         a sidebar on the window's base, as the playlists view and Windows Settings have
         them, the settings first and the keyboard shortcuts and About at its foot; the
         selected category's page on the content layer, under its title. -->
    <Grid x:Name="Root" SizeChanged="OnSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Padding="6,6,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="Categories"
                AutomationProperties.Name="{x:Bind h:Strings.Preferences}"
                Background="Transparent"
                ItemContainerStyle="{StaticResource CategoryItemStyle}"
                SelectionChanged="OnCategoryChanged"
                SelectionMode="Single">
                <ListViewItem AutomationProperties.Name="{x:Bind h:Strings.PrefsPlayback}" Tag="playback">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE768;" />
                        <TextBlock Text="{x:Bind h:Strings.PrefsPlayback}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem AutomationProperties.Name="{x:Bind h:Strings.PrefsOutput}" Tag="output">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE7F5;" />
                        <TextBlock Text="{x:Bind h:Strings.PrefsOutput}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem AutomationProperties.Name="{x:Bind h:Strings.PrefsControls}" Tag="controls">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE9E9;" />
                        <TextBlock Text="{x:Bind h:Strings.PrefsControls}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem AutomationProperties.Name="{x:Bind h:Strings.MusicFolders}" Tag="folders">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                        <TextBlock Text="{x:Bind h:Strings.MusicFolders}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem AutomationProperties.Name="{x:Bind h:Strings.PrefsReset}" Tag="reset">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE777;" />
                        <TextBlock Text="{x:Bind h:Strings.PrefsReset}" />
                    </StackPanel>
                </ListViewItem>
            </ListView>
            <!-- At the foot, like NavigationView's footer items -->
            <ListView
                x:Name="FooterCategories"
                Grid.Row="1"
                AutomationProperties.Name="{x:Bind h:Strings.Preferences}"
                Background="Transparent"
                ItemContainerStyle="{StaticResource CategoryItemStyle}"
                SelectionChanged="OnCategoryChanged"
                SelectionMode="Single">
                <ListViewItem AutomationProperties.Name="{x:Bind h:Strings.KeyboardShortcuts}" Tag="shortcuts">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE765;" />
                        <TextBlock Text="{x:Bind h:Strings.KeyboardShortcuts}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem AutomationProperties.Name="{x:Bind h:Strings.About}" Tag="about">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                        <TextBlock Text="{x:Bind h:Strings.About}" />
                    </StackPanel>
                </ListViewItem>
            </ListView>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource SplitContentLayerStyle}">
            <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1000" Padding="32,24,32,40">
                    <TextBlock
                        x:Name="PageTitle"
                        Margin="0,0,0,20"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource TitleLabelStyle}" />
                    <Grid>
                        <!-- Playback: GNOME Music's player settings, the channel processing, power -->
                        <StackPanel x:Name="PlaybackPage">
                            <TextBlock Style="{StaticResource FirstGroupTitleStyle}" Text="{x:Bind h:Strings.PlayerSettings}" />
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind h:Strings.RepeatModeTitle}" />
                                        <ComboBox
                                            x:Name="RepeatCombo"
                                            Grid.Column="1"
                                            MinWidth="150"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind h:Strings.RepeatModeTitle}"
                                            SelectionChanged="OnRepeatChanged">
                                            <ComboBoxItem Content="{x:Bind h:Strings.RepeatModeNone}" />
                                            <ComboBoxItem Content="{x:Bind h:Strings.RepeatModeSong}" />
                                            <ComboBoxItem Content="{x:Bind h:Strings.RepeatModeAll}" />
                                            <ComboBoxItem Content="{x:Bind h:Strings.RepeatShuffle}" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind h:Strings.ReplayGain}" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="ReplayGainCombo"
                                            Grid.Column="1"
                                            MinWidth="150"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind h:Strings.ReplayGain}"
                                            SelectionChanged="OnReplayGainChanged">
                                            <ComboBoxItem Content="{x:Bind h:Strings.ReplayGainDisabled}" />
                                            <ComboBoxItem Content="{x:Bind h:Strings.ReplayGainAlbum}" />
                                            <ComboBoxItem Content="{x:Bind h:Strings.ReplayGainTrack}" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
        
                            <TextBlock Style="{StaticResource GroupTitleStyle}" Text="{x:Bind h:Strings.ChannelProcessing}" />
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind h:Strings.PhaseInvert}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="InvertSwitch"
                                            Grid.Column="1"
                                            AutomationProperties.Name="{x:Bind h:Strings.PhaseInvert}"
                                            Style="{StaticResource RowSwitchStyle}"
                                            Toggled="OnProcessingToggled" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind h:Strings.MonoOutput}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="MonoSwitch"
                                            Grid.Column="1"
                                            AutomationProperties.Name="{x:Bind h:Strings.MonoOutput}"
                                            Style="{StaticResource RowSwitchStyle}"
                                            Toggled="OnProcessingToggled" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind h:Strings.SwapChannels}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="SwapSwitch"
                                            Grid.Column="1"
                                            AutomationProperties.Name="{x:Bind h:Strings.SwapChannels}"
                                            Style="{StaticResource RowSwitchStyle}"
                                            Toggled="OnProcessingToggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>
        
                            <TextBlock Style="{StaticResource GroupTitleStyle}" Text="{x:Bind h:Strings.PowerSettings}" />
                            <Border Style="{StaticResource GroupCardStyle}">
                                <Grid Style="{StaticResource RowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind h:Strings.InhibitSuspend}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="InhibitSwitch"
                                        Grid.Column="1"
                                        AutomationProperties.Name="{x:Bind h:Strings.InhibitSuspend}"
                                        Style="{StaticResource RowSwitchStyle}"
                                        Toggled="OnInhibitToggled" />
                                </Grid>
                            </Border>
                        </StackPanel>
        
                        <!-- Music output: the interface and device, what the device takes, DSD -->
                        <StackPanel x:Name="OutputPage" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FirstGroupTitleStyle}" Text="{x:Bind h:Strings.OutputDevice}" />
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind h:Strings.AudioInterface}" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="ApiCombo"
                                            Grid.Column="1"
                                            MinWidth="150"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind h:Strings.AudioInterface}"
                                            SelectionChanged="OnApiChanged">
                                            <ComboBoxItem Content="WASAPI" />
                                            <ComboBoxItem Content="DirectSound" />
                                            <ComboBoxItem Content="ASIO" />
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel x:Name="ExclusiveRow">
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Grid Style="{StaticResource RowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind h:Strings.ExclusiveMode}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="ExclusiveSwitch"
                                                Grid.Column="1"
                                                AutomationProperties.Name="{x:Bind h:Strings.ExclusiveMode}"
                                                Style="{StaticResource RowSwitchStyle}"
                                                Toggled="OnExclusiveToggled" />
                                        </Grid>
                                    </StackPanel>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind h:Strings.Device}" />
                                        <ComboBox
                                            x:Name="DeviceCombo"
                                            Grid.Column="1"
                                            MinWidth="150"
                                            MaxWidth="340"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind h:Strings.Device}"
                                            DisplayMemberPath="Name"
                                            SelectionChanged="OnDeviceChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>
        
                            <TextBlock Style="{StaticResource GroupTitleStyle}" Text="{x:Bind h:Strings.DeviceFormats}" />
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource InfoRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind h:Strings.PcmRates}" />
                                        <TextBlock
                                            x:Name="RatesText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalTextAlignment="Right"
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource SecondaryLabelStyle}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Style="{StaticResource InfoRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind h:Strings.BitDepths}" />
                                        <TextBlock
                                            x:Name="DepthsText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalTextAlignment="Right"
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource SecondaryLabelStyle}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Style="{StaticResource InfoRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind h:Strings.DsdRates}" />
                                        <TextBlock
                                            x:Name="DsdText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalTextAlignment="Right"
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource SecondaryLabelStyle}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Style="{StaticResource InfoRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind h:Strings.ChannelCounts}" />
                                        <TextBlock
                                            x:Name="ChannelsText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalTextAlignment="Right"
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource SecondaryLabelStyle}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <StackPanel x:Name="FormatsNoteRow" Visibility="Collapsed">
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <TextBlock
                                            x:Name="FormatsNote"
                                            Margin="14,10"
                                            Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
        
                            <TextBlock Style="{StaticResource GroupTitleStyle}" Text="DSD" />
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind h:Strings.DsdTransport}" />
                                            <TextBlock x:Name="DsdModeDescription" Style="{StaticResource RowDescriptionStyle}" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="DsdCombo"
                                            Grid.Column="1"
                                            MinWidth="150"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind h:Strings.DsdTransport}"
                                            SelectionChanged="OnDsdModeChanged">
                                            <ComboBoxItem Content="{x:Bind h:Strings.DsdConvert}" />
                                            <ComboBoxItem Content="{x:Bind h:Strings.DsdDop}" />
                                            <ComboBoxItem Content="{x:Bind h:Strings.DsdNative}" />
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel x:Name="GainRow">
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Grid Style="{StaticResource RowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind h:Strings.DsdGain}" />
                                            </StackPanel>
                                            <Slider
                                                x:Name="GainSlider"
                                                Grid.Column="1"
                                                Width="150"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind h:Strings.DsdGain}"
                                                IsThumbToolTipEnabled="False"
                                                LargeChange="1"
                                                Maximum="6"
                                                Minimum="0"
                                                SmallChange="0.5"
                                                StepFrequency="0.5"
                                                ValueChanged="OnGainChanged" />
                                            <TextBlock
                                                x:Name="GainText"
                                                Grid.Column="2"
                                                MinWidth="52"
                                                VerticalAlignment="Center"
                                                HorizontalTextAlignment="Right"
                                                Typography.NumeralAlignment="Tabular" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
        
                        <!-- Player controls: the features that can be turned off, the format line -->
                        <StackPanel x:Name="ControlsPage" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FirstGroupTitleStyle}" Text="{x:Bind h:Strings.Features}" />
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind h:Strings.FeatureMiniPlayer}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="MiniPlayerSwitch"
                                            Grid.Column="1"
                                            AutomationProperties.Name="{x:Bind h:Strings.FeatureMiniPlayer}"
                                            Style="{StaticResource RowSwitchStyle}"
                                            Toggled="OnFeatureToggled" />
                                    </Grid>
                                    <!-- What the mini player shows; only with the mini player on. One
                                         of the two notes the preferences keep (the user asked for
                                         both): songs without lyrics show the cover in the lyrics mode. -->
                                    <Border Style="{StaticResource SubRowDividerStyle}" />
                                    <Grid Style="{StaticResource SubRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="MiniPlayerModeLabel" Text="{x:Bind h:Strings.MiniPlayerMode}" />
                                            <TextBlock
                                                x:Name="MiniPlayerLyricsNote"
                                                Style="{StaticResource RowDescriptionStyle}"
                                                Text="{x:Bind h:Strings.MiniPlayerLyricsNote}"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="MiniPlayerModeCombo"
                                            Grid.Column="1"
                                            MinWidth="150"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind h:Strings.MiniPlayerMode}"
                                            SelectionChanged="OnMiniPlayerModeChanged">
                                            <ComboBoxItem Content="{x:Bind h:Strings.MiniPlayerModeCover}" />
                                            <ComboBoxItem Content="{x:Bind h:Strings.MiniPlayerModeControls}" />
                                            <ComboBoxItem Content="{x:Bind h:Strings.MiniPlayerModeLyrics}" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind h:Strings.FeatureOutputButton}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="OutputButtonSwitch"
                                            Grid.Column="1"
                                            AutomationProperties.Name="{x:Bind h:Strings.FeatureOutputButton}"
                                            Style="{StaticResource RowSwitchStyle}"
                                            Toggled="OnFeatureToggled" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <!-- The other note the preferences keep: without the volume control
                                         the app plays at full volume (Player.ApplyVolume). -->
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind h:Strings.FeatureVolume}" />
                                            <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="{x:Bind h:Strings.VolumeControlNote}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="VolumeSwitch"
                                            Grid.Column="1"
                                            AutomationProperties.Name="{x:Bind h:Strings.FeatureVolume}"
                                            Style="{StaticResource RowSwitchStyle}"
                                            Toggled="OnFeatureToggled" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind h:Strings.FeatureLyrics}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="LyricsSwitch"
                                            Grid.Column="1"
                                            AutomationProperties.Name="{x:Bind h:Strings.FeatureLyrics}"
                                            Style="{StaticResource RowSwitchStyle}"
                                            Toggled="OnFeatureToggled" />
                                    </Grid>
        
                                    <!-- Where the lyrics come from; only with the lyrics on -->
                                    <Border Style="{StaticResource SubRowDividerStyle}" />
                                    <Grid Style="{StaticResource SubRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="LocalLyricsLabel" Text="{x:Bind h:Strings.LoadLocalLyrics}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="LocalLyricsSwitch"
                                            Grid.Column="1"
                                            AutomationProperties.Name="{x:Bind h:Strings.LoadLocalLyrics}"
                                            Style="{StaticResource RowSwitchStyle}"
                                            Toggled="OnLyricsOptionToggled" />
                                    </Grid>
                                    <Border Style="{StaticResource SubRowDividerStyle}" />
                                    <Grid Style="{StaticResource SubRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="DownloadLyricsLabel" Text="{x:Bind h:Strings.DownloadLyrics}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="DownloadLyricsSwitch"
                                            Grid.Column="1"
                                            AutomationProperties.Name="{x:Bind h:Strings.DownloadLyrics}"
                                            Style="{StaticResource RowSwitchStyle}"
                                            Toggled="OnLyricsOptionToggled" />
                                    </Grid>
                                    <!-- Where downloads go: downloaded ones and those picked in a song's properties -->
                                    <Border Style="{StaticResource SubRowDividerStyle}" />
                                    <Grid Style="{StaticResource SubRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="LyricsLocationLabel" Text="{x:Bind h:Strings.LyricsLocation}" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="LyricsLocationCombo"
                                            Grid.Column="1"
                                            MinWidth="150"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind h:Strings.LyricsLocation}"
                                            SelectionChanged="OnLyricsLocationChanged">
                                            <ComboBoxItem Content="{x:Bind h:Strings.LyricsLocationSongFolder}" />
                                            <ComboBoxItem Content="{x:Bind h:Strings.LyricsLocationCache}" />
                                        </ComboBox>
                                    </Grid>
                                    <!-- Songs LRCLIB had nothing for are remembered (in the lyrics cache) -->
                                    <Border Style="{StaticResource SubRowDividerStyle}" />
                                    <Grid Style="{StaticResource SubRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="RememberMissingLyricsLabel"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind h:Strings.RememberMissingLyrics}" />
                                        <ToggleSwitch
                                            x:Name="RememberMissingLyricsSwitch"
                                            Grid.Column="1"
                                            AutomationProperties.Name="{x:Bind h:Strings.RememberMissingLyrics}"
                                            Style="{StaticResource RowSwitchStyle}"
                                            Toggled="OnLyricsOptionToggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>
        
                            <TextBlock Style="{StaticResource GroupTitleStyle}" Text="{x:Bind h:Strings.Display}" />
                            <Border Style="{StaticResource GroupCardStyle}">
                                <Grid Style="{StaticResource RowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind h:Strings.ShowAudioFormat}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="FormatSwitch"
                                        Grid.Column="1"
                                        AutomationProperties.Name="{x:Bind h:Strings.ShowAudioFormat}"
                                        Style="{StaticResource RowSwitchStyle}"
                                        Toggled="OnFeatureToggled" />
                                </Grid>
                            </Border>
                        </StackPanel>
        
                        <!-- Windows port: the folders scanned for music -->
                        <StackPanel x:Name="FoldersPage" Visibility="Collapsed">
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <ItemsControl x:Name="FoldersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid Style="{StaticResource RowStyle}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Glyph="&#xE8B7;" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BodyLabelStyle}"
                                                        Text="{x:Bind}"
                                                        ToolTipService.ToolTip="{x:Bind}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        AutomationProperties.Name="{x:Bind h:Strings.RemoveFolder}"
                                                        Click="OnRemoveFolderClick"
                                                        Style="{StaticResource SubtleIconButtonStyle}"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="{x:Bind h:Strings.RemoveFolder}">
                                                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Button
                                            HorizontalAlignment="Right"
                                            Click="OnAddFolderClick"
                                            Content="{x:Bind h:Strings.AddFolder}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Windows port: starting over in part. Each action asks first. -->
                        <StackPanel x:Name="ResetPage" Visibility="Collapsed">
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind h:Strings.ClearLyricsCache}" />
                                        <!-- What the cache holds, as a value -->
                                        <TextBlock
                                            x:Name="LyricsCacheSize"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryLabelStyle}"
                                            Typography.NumeralAlignment="Tabular" />
                                        <Button
                                            x:Name="ClearLyricsCacheButton"
                                            Grid.Column="2"
                                            MinWidth="96"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind h:Strings.ClearLyricsCache}"
                                            Click="OnClearLyricsCacheClick"
                                            Content="{x:Bind h:Strings.Clear}" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind h:Strings.ClearPlayCounts}" />
                                        </StackPanel>
                                        <Button
                                            x:Name="ClearPlayCountsButton"
                                            Grid.Column="1"
                                            MinWidth="96"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind h:Strings.ClearPlayCounts}"
                                            Click="OnClearPlayCountsClick"
                                            Content="{x:Bind h:Strings.Clear}" />
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind h:Strings.ResetSettings}" />
                                        </StackPanel>
                                        <Button
                                            x:Name="ResetSettingsButton"
                                            Grid.Column="1"
                                            MinWidth="96"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind h:Strings.ResetSettings}"
                                            Click="OnResetSettingsClick"
                                            Content="{x:Bind h:Strings.ResetAction}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- The keyboard shortcuts (shortcuts-dialog.ui), filled in code -->
                        <StackPanel x:Name="ShortcutsPage" Visibility="Collapsed" />

                        <!-- About (about.py), with the help, filled in code -->
                        <StackPanel x:Name="AboutPage" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
