<Page
    x:Class="Gnome_Music_WinUI.Views.ArtistsSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    xmlns:models="using:Gnome_Music_WinUI.Models"
    Background="Transparent">

    <!-- ArtistsSearchNavigationPage.ui: all artist results -->
    <Border Style="{StaticResource ContentLayerStyle}">
        <GridView
            x:Name="ArtistsGrid"
            Padding="18,20"
            IsItemClickEnabled="True"
            ItemClick="OnArtistClick"
            ItemContainerStyle="{StaticResource TileGridViewItemStyle}"
            SelectionMode="None">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid HorizontalAlignment="Center" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:CoreArtist">
                    <controls:ArtistSearchTile Artist="{x:Bind}" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Border>
</Page>
