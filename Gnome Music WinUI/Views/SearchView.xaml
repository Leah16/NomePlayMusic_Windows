<UserControl
    x:Class="Gnome_Music_WinUI.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    xmlns:h="using:Gnome_Music_WinUI.Helpers"
    xmlns:models="using:Gnome_Music_WinUI.Models">

    <UserControl.Resources>
        <!-- "View All ›": a subtle button next to the section title -->
        <Style x:Key="ViewAllButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource ContentLayerStyle}">
        <Grid>
            <!-- Results (SearchView.ui "main") -->
            <ScrollViewer x:Name="ResultsScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <controls:Clamp MaximumSize="1600">
                    <StackPanel x:Name="ResultsPanel" Margin="120,20,120,20">
                        <!-- Artists -->
                        <Grid x:Name="ArtistsHeader">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleLabelStyle}"
                                Text="{x:Bind h:Strings.Artists}" />
                            <Button
                                x:Name="AllArtistsButton"
                                Click="OnAllArtistsClick"
                                Style="{StaticResource ViewAllButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind h:Strings.ViewAll}" />
                                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <GridView
                            x:Name="ArtistsGrid"
                            Margin="0,18"
                            IsItemClickEnabled="True"
                            ItemClick="OnArtistClick"
                            ItemContainerStyle="{StaticResource TileGridViewItemStyle}"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:CoreArtist">
                                    <controls:ArtistSearchTile Artist="{x:Bind}" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- Albums -->
                        <Grid x:Name="AlbumsHeader">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleLabelStyle}"
                                Text="{x:Bind h:Strings.Albums}" />
                            <Button
                                x:Name="AllAlbumsButton"
                                Click="OnAllAlbumsClick"
                                Style="{StaticResource ViewAllButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind h:Strings.ViewAll}" />
                                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <GridView
                            x:Name="AlbumsGrid"
                            Margin="0,18"
                            IsItemClickEnabled="True"
                            ItemClick="OnAlbumClick"
                            ItemContainerStyle="{StaticResource TileGridViewItemStyle}"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:CoreAlbum">
                                    <controls:AlbumTile Album="{x:Bind}" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- Songs -->
                        <TextBlock
                            x:Name="SongsHeader"
                            Style="{StaticResource SubtitleLabelStyle}"
                            Text="{x:Bind h:Strings.Songs}" />
                        <Border
                            x:Name="SongsCard"
                            Margin="0,20,0,0"
                            Style="{StaticResource CardStyle}">
                            <ListView
                                x:Name="SongsList"
                                IsItemClickEnabled="True"
                                ItemClick="OnSongClick"
                                ItemContainerStyle="{StaticResource CardListItemStyle}"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CoreSong">
                                        <controls:SongRow
                                            PlayRequested="OnSongPlayRequested"
                                            ShowArtistAndAlbum="True"
                                            Song="{x:Bind}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>
                </controls:Clamp>
            </ScrollViewer>

            <!-- "status": no search started / no results (AdwStatusPage) -->
            <StackPanel
                x:Name="StatusPanel"
                MaxWidth="560"
                Margin="36,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <TextBlock
                    x:Name="StatusTitle"
                    HorizontalAlignment="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource TitleLabelStyle}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    x:Name="StatusDescription"
                    HorizontalAlignment="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SecondaryLabelStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
