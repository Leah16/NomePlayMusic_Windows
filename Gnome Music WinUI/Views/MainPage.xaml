<Page
    x:Class="Gnome_Music_WinUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Gnome_Music_WinUI.Views"
    Background="Transparent"
    NavigationCacheMode="Required">

    <!-- Window.ui: the view stack, the status page and the search view; and the
         preferences, a view of the stack here -->
    <Grid>
        <views:AlbumsView x:Name="AlbumsView" Visibility="Collapsed" />
        <views:ArtistsView x:Name="ArtistsView" Visibility="Collapsed" />
        <views:PlaylistsView x:Name="PlaylistsView" Visibility="Collapsed" />
        <views:PreferencesView x:Name="PreferencesView" Visibility="Collapsed" />
        <views:SearchView x:Name="SearchView" Visibility="Collapsed" />
        <views:StatusView x:Name="StatusView" Visibility="Collapsed" />

        <!-- Loading indicator (notificationmanager.py): a thin pulsing bar at the top -->
        <ProgressBar
            x:Name="LoadingBar"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="Collapsed" />
    </Grid>
</Page>
