<UserControl
    x:Class="Gnome_Music_WinUI.Views.PlaylistsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    xmlns:h="using:Gnome_Music_WinUI.Helpers"
    xmlns:models="using:Gnome_Music_WinUI.Models"
    xmlns:views="using:Gnome_Music_WinUI.Views">

    <UserControl.Resources>
        <DataTemplate x:Key="PlaylistTemplate" x:DataType="models:Playlist">
            <controls:PlaylistTile Playlist="{x:Bind}" />
        </DataTemplate>
        <!-- Separator between smart and user playlists (2 px, margins 16) -->
        <DataTemplate x:Key="SeparatorTemplate" x:DataType="views:SidebarSeparator">
            <Border
                Height="2"
                Margin="8,4"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </DataTemplate>
        <views:SidebarTemplateSelector
            x:Key="SidebarSelector"
            PlaylistTemplate="{StaticResource PlaylistTemplate}"
            SeparatorTemplate="{StaticResource SeparatorTemplate}" />
    </UserControl.Resources>

    <!-- PlaylistsView.ui: AdwOverlaySplitView, sidebar of playlists and the playlist pane -->
    <Grid x:Name="Root" SizeChanged="OnSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The sidebar stays on the window's base -->
        <ListView
            x:Name="PlaylistsList"
            Padding="6,6,6,4"
            AutomationProperties.Name="{x:Bind h:Strings.Playlists}"
            Background="Transparent"
            ContainerContentChanging="OnContainerContentChanging"
            ItemContainerStyle="{StaticResource SidebarItemStyle}"
            ItemTemplateSelector="{StaticResource SidebarSelector}"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single" />

        <Border Grid.Column="1" Style="{StaticResource SplitContentLayerStyle}">
            <controls:PlaylistsWidget x:Name="PlaylistPane" />
        </Border>
    </Grid>
</UserControl>
