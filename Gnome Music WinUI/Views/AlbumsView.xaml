<UserControl
    x:Class="Gnome_Music_WinUI.Views.AlbumsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    xmlns:h="using:Gnome_Music_WinUI.Helpers"
    xmlns:models="using:Gnome_Music_WinUI.Models">

    <!-- AlbumsView.ui: GridView, max 10 columns, single-click activation, padding 18 -->
    <Border Style="{StaticResource ContentLayerStyle}">
        <GridView
            x:Name="AlbumsGrid"
            Padding="18,18,18,18"
            AutomationProperties.Name="{x:Bind h:Strings.Albums}"
            IsItemClickEnabled="True"
            ItemClick="OnAlbumClick"
            ItemContainerStyle="{StaticResource TileGridViewItemStyle}"
            ItemsSource="{x:Bind Model.Albums, Mode=OneWay}"
            SelectionMode="None"
            SizeChanged="OnSizeChanged">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:CoreAlbum">
                    <controls:AlbumTile Album="{x:Bind}" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Border>
</UserControl>
