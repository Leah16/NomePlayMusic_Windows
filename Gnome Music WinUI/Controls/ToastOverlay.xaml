<UserControl
    x:Class="Gnome_Music_WinUI.Controls.ToastOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Gnome_Music_WinUI.Helpers"
    HorizontalAlignment="Center"
    VerticalAlignment="Bottom"
    IsTabStop="False">

    <!-- A floating card (Fluent 2 toast): solid surface, flyout stroke, 8 px corners
         and a shadow. Acrylic is kept for the title bar. -->
    <Border
        x:Name="ToastBorder"
        MinHeight="44"
        Margin="12,12,12,24"
        Padding="18,4,6,4"
        Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource OverlayCornerRadius}"
        Opacity="0"
        Shadow="{StaticResource ToastShadow}"
        Translation="0,24,32"
        Visibility="Collapsed">
        <Border.OpacityTransition>
            <ScalarTransition Duration="0:0:0.2" />
        </Border.OpacityTransition>
        <Border.TranslationTransition>
            <Vector3Transition Duration="0:0:0.2" />
        </Border.TranslationTransition>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock
                x:Name="TitleText"
                MaxWidth="420"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="ActionButton"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Click="OnActionClick"
                Visibility="Collapsed" />
            <Button
                x:Name="CloseButton"
                Width="32"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind h:Strings.Close}"
                Click="OnCloseClick"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="{x:Bind h:Strings.Close}">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
