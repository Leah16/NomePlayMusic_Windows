<UserControl
    x:Class="Gnome_Music_WinUI.Controls.DiscBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    xmlns:models="using:Gnome_Music_WinUI.Models"
    IsTabStop="False">

    <!-- DiscBox.ui: "Disc N" heading and the disc's songs in a card -->
    <StackPanel>
        <TextBlock
            x:Name="TitleText"
            Padding="0,12"
            Style="{StaticResource StrongLabelStyle}"
            Visibility="Collapsed" />
        <Border Style="{StaticResource CardStyle}">
            <ListView
                x:Name="SongsList"
                IsItemClickEnabled="True"
                ItemClick="OnSongClick"
                ItemContainerStyle="{StaticResource CardListItemStyle}"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CoreSong">
                        <controls:SongRow PlayRequested="OnSongPlayRequested" Song="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </StackPanel>
</UserControl>
