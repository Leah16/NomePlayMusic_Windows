<UserControl
    x:Class="Gnome_Music_WinUI.Controls.LyricsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Gnome_Music_WinUI.Helpers"
    Visibility="Collapsed">

    <UserControl.Resources>
        <!-- Lines: large bold text in the color of the cover, on white -->
        <Style x:Key="LyricTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource NowPlayingBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Synced lines seek when clicked: subtle buttons, with the hover and pressed plates -->
        <Style
            x:Key="LyricButtonStyle"
            BasedOn="{StaticResource SubtleButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <!-- Fluent motion: the page fades in over the window while the lines come up
             (decelerate); both go quickly (accelerate). The page itself does not move,
             so it always meets the top of the window. -->
        <Storyboard x:Key="OpenStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                <SplineDoubleKeyFrame
                    KeySpline="0,0 0,1"
                    KeyTime="0:0:0.25"
                    Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ColumnTranslate" Storyboard.TargetProperty="Y">
                <DiscreteDoubleKeyFrame KeyTime="0" Value="48" />
                <SplineDoubleKeyFrame
                    KeySpline="0,0 0,1"
                    KeyTime="0:0:0.333"
                    Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="CloseStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame
                    KeySpline="1,0 1,1"
                    KeyTime="0:0:0.167"
                    Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ColumnTranslate" Storyboard.TargetProperty="Y">
                <SplineDoubleKeyFrame
                    KeySpline="1,0 1,1"
                    KeyTime="0:0:0.167"
                    Value="24" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <!-- The lyrics view (not in GNOME Music): a plain white page over the whole window,
         the title bar included, in one piece with it. The lines scroll up to the top
         edge, under the caption buttons; they start below the Padding (the title bar),
         which scrolls with them. The player bar covers the bottom (BottomInset) and
         draws its own edge; when the bar steps aside, the lines show down to the bottom
         of the window. The lines keep the current one a little above the middle; played
         lines are faint, the current one is in full color. -->
    <Grid x:Name="Surface" Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}">
        <ScrollViewer
            x:Name="Scroller"
            AutomationProperties.Name="{x:Bind h:Strings.Lyrics}"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <!-- As wide as the view; the code centres the lines with the padding -->
            <StackPanel x:Name="Column">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ColumnTranslate" />
                </StackPanel.RenderTransform>
                <!-- "Lyrics not synced" or "Instrumental": small, at the very top -->
                <TextBlock
                    x:Name="Hint"
                    Margin="0,0,0,12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource NowPlayingBrush}"
                    Opacity="0.7"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Visibility="Collapsed" />
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Bind h:Strings.LyricsLoading}"
                    Foreground="{ThemeResource NowPlayingBrush}"
                    IsActive="False"
                    Visibility="Collapsed" />
                <!-- Tab enters the lines once; the arrow keys move between them -->
                <StackPanel
                    x:Name="LinesPanel"
                    TabFocusNavigation="Once"
                    XYFocusKeyboardNavigation="Enabled" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
