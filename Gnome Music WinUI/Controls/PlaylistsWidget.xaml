<UserControl
    x:Class="Gnome_Music_WinUI.Controls.PlaylistsWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    xmlns:h="using:Gnome_Music_WinUI.Helpers"
    xmlns:models="using:Gnome_Music_WinUI.Models">

    <UserControl.Resources>
        <!-- The songs scroll in one card, at most 1000 px wide (AdwClamp); the list's
             Padding is the card's margin. Otherwise WinUI's ListView template. -->
        <Style x:Key="SongsCardListViewStyle" TargetType="ListView">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListView">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ScrollViewer
                                x:Name="ScrollViewer"
                                AutomationProperties.AccessibilityView="Raw"
                                BringIntoViewOnFocusChange="{TemplateBinding ScrollViewer.BringIntoViewOnFocusChange}"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                                IsHorizontalScrollChainingEnabled="{TemplateBinding ScrollViewer.IsHorizontalScrollChainingEnabled}"
                                IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                                IsVerticalScrollChainingEnabled="{TemplateBinding ScrollViewer.IsVerticalScrollChainingEnabled}"
                                TabNavigation="{TemplateBinding TabNavigation}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                ZoomMode="{TemplateBinding ScrollViewer.ZoomMode}">
                                <Border
                                    MaxWidth="1000"
                                    Margin="{TemplateBinding Padding}"
                                    Style="{StaticResource CardStyle}">
                                    <ItemsPresenter
                                        Footer="{TemplateBinding Footer}"
                                        FooterTemplate="{TemplateBinding FooterTemplate}"
                                        FooterTransitions="{TemplateBinding FooterTransitions}"
                                        Header="{TemplateBinding Header}"
                                        HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                        HeaderTransitions="{TemplateBinding HeaderTransitions}" />
                                </Border>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- PlaylistsWidget.ui: PlaylistControls above the scrolled song list -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- PlaylistControls.ui -->
        <controls:Clamp Margin="12,0" MaximumSize="1000">
            <StackPanel Margin="0,30,0,0">
                <Grid>
                    <TextBlock
                        x:Name="TitleText"
                        Margin="0,0,0,10"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource TitleLabelStyle}" />
                    <!-- "renaming_dialog": entry and Done button, joined -->
                    <StackPanel
                        x:Name="RenamePanel"
                        Margin="0,0,0,10"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <TextBox
                            x:Name="RenameEntry"
                            MinWidth="260"
                            CornerRadius="4,0,0,4"
                            KeyDown="OnRenameKeyDown"
                            PlaceholderText="{x:Bind h:Strings.PlaylistName}"
                            TextChanged="OnRenameTextChanged" />
                        <Button
                            x:Name="RenameDoneButton"
                            VerticalAlignment="Stretch"
                            Click="OnRenameDoneClick"
                            Content="{x:Bind h:Strings.Done}"
                            CornerRadius="0,4,4,0"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    x:Name="CountText"
                    Margin="0,0,0,4"
                    Style="{StaticResource SecondaryLabelStyle}" />
                <!-- Standard buttons: a playlist mixes albums, so there is no one color
                     for play (the playing song shows the color of its cover) -->
                <StackPanel
                    Margin="0,18,0,8"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        x:Name="PlayButton"
                        AutomationProperties.Name="{x:Bind h:Strings.Play}"
                        Click="OnPlayClick"
                        Style="{StaticResource LargeIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind h:Strings.Play}">
                        <FontIcon FontSize="16" Glyph="&#xF5B0;" />
                    </Button>
                    <Button
                        x:Name="MenuButton"
                        AutomationProperties.Name="{x:Bind h:Strings.Menu}"
                        Style="{StaticResource LargeIconButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Opening="OnMenuOpening" Placement="Bottom">
                                <MenuFlyoutItem x:Name="PlayItem" Click="OnPlayClick" Text="{x:Bind h:Strings.MenuPlay}" />
                                <MenuFlyoutItem x:Name="DeleteItem" Click="OnDeleteClick" Text="{x:Bind h:Strings.MenuDelete}" />
                                <MenuFlyoutItem x:Name="RenameItem" Click="OnRenameClick" Text="{x:Bind h:Strings.MenuRename}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </controls:Clamp>

        <!-- _songs_list: the songs in a card, margins 20 -->
        <ListView
            x:Name="SongsList"
            Grid.Row="1"
            Padding="12,20"
            ContainerContentChanging="OnContainerContentChanging"
            DragItemsCompleted="OnDragItemsCompleted"
            IsItemClickEnabled="True"
            ItemClick="OnSongClick"
            ItemContainerStyle="{StaticResource CardListItemStyle}"
            SelectionMode="None"
            Style="{StaticResource SongsCardListViewStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:CoreSong">
                    <controls:SongRow
                        PlayRequested="OnSongPlayRequested"
                        RemoveRequested="OnSongRemoveRequested"
                        ShowArtistAndAlbum="True"
                        Song="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
