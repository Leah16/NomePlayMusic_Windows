<UserControl
    x:Class="Gnome_Music_WinUI.Controls.ArtistTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls">

    <!-- ArtistTile.ui: 42 px round artist image and the name -->
    <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:CoverArt
            VerticalAlignment="Center"
            Album="{x:Bind Artist.CoverAlbum, Mode=OneWay}"
            Glyph="&#xE77B;"
            Radius="21"
            Size="42" />
        <TextBlock
            Grid.Column="1"
            Margin="0,16"
            VerticalAlignment="Center"
            Style="{StaticResource BodyLabelStyle}"
            Text="{x:Bind Artist.Name, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Artist.Name, Mode=OneWay}" />
    </Grid>
</UserControl>
