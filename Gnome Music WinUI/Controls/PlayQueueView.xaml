<UserControl
    x:Class="Gnome_Music_WinUI.Controls.PlayQueueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    xmlns:h="using:Gnome_Music_WinUI.Helpers"
    Width="380">

    <!-- The play queue overlay (not in GNOME Music): the songs in play order.
         Clicking one plays it. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Padding="20,16,20,10" Spacing="2">
            <TextBlock Style="{StaticResource SubtitleLabelStyle}" Text="{x:Bind h:Strings.PlayQueue}" />
            <TextBlock x:Name="CountText" Style="{StaticResource SecondaryCaptionLabelStyle}" />
        </StackPanel>

        <ListView
            x:Name="SongsList"
            Grid.Row="1"
            Padding="4,0,4,8"
            AutomationProperties.Name="{x:Bind h:Strings.PlayQueue}"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemContainerStyle="{StaticResource SidebarItemStyle}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="controls:QueueEntry">
                    <controls:QueueRow Song="{x:Bind Song}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
