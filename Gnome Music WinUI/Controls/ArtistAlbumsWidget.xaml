<UserControl
    x:Class="Gnome_Music_WinUI.Controls.ArtistAlbumsWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    xmlns:models="using:Gnome_Music_WinUI.Models">

    <!-- ArtistAlbumsWidget.ui: the artist's albums stacked, each an AlbumWidget without
         the artist line, in an AdwClamp(1000) -->
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <controls:Clamp Margin="12,0" MaximumSize="1000">
            <ItemsRepeater x:Name="AlbumsRepeater">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:CoreAlbum">
                        <controls:AlbumWidget Album="{x:Bind}" ShowArtistLabel="False" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:Clamp>
    </ScrollViewer>
</UserControl>
