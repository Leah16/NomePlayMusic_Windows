<UserControl
    x:Class="Gnome_Music_WinUI.Controls.ArtistSearchTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    HorizontalAlignment="Center"
    VerticalAlignment="Top">

    <!-- ArtistSearchTile.ui: 192 px round image and the name -->
    <StackPanel Width="204" ToolTipService.ToolTip="{x:Bind Artist.Name, Mode=OneWay}">
        <controls:CoverArt
            Margin="6"
            HorizontalAlignment="Center"
            Album="{x:Bind Artist.CoverAlbum, Mode=OneWay}"
            Glyph="&#xE77B;"
            Radius="90"
            Size="192" />
        <TextBlock
            Margin="6,0"
            HorizontalAlignment="Center"
            HorizontalTextAlignment="Center"
            Style="{StaticResource BodyLabelStyle}"
            Text="{x:Bind Artist.Name, Mode=OneWay}" />
    </StackPanel>
</UserControl>
