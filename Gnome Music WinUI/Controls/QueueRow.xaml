<UserControl
    x:Class="Gnome_Music_WinUI.Controls.QueueRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    HorizontalContentAlignment="Stretch">

    <!-- A song of the play queue: play indicator, cover, title and artist, duration -->
    <Grid Padding="0,6" ColumnSpacing="10">
        <VisualStateManager.VisualStateGroups>
            <!-- Like the song rows: the playing song in the color of its cover (App.xaml),
                 a song that failed to play with the critical color on its icon -->
            <VisualStateGroup x:Name="PlaybackStates">
                <VisualState x:Name="Idle" />
                <VisualState x:Name="Playing">
                    <VisualState.Setters>
                        <Setter Target="PlayIcon.Foreground" Value="{ThemeResource NowPlayingBrush}" />
                        <Setter Target="TitleText.Foreground" Value="{ThemeResource NowPlayingBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Failed">
                    <VisualState.Setters>
                        <Setter Target="PlayIcon.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <FontIcon
            x:Name="PlayIcon"
            VerticalAlignment="Center"
            FontSize="12"
            Glyph="&#xF5B0;"
            Visibility="Collapsed" />

        <controls:CoverArt
            x:Name="Cover"
            Grid.Column="1"
            VerticalAlignment="Center"
            Radius="4"
            Size="40" />

        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Spacing="1">
            <TextBlock x:Name="TitleText" Style="{StaticResource BodyLabelStyle}" />
            <TextBlock x:Name="ArtistText" Style="{StaticResource SecondaryCaptionLabelStyle}" />
        </StackPanel>

        <TextBlock
            x:Name="DurationText"
            Grid.Column="3"
            Margin="0,0,4,0"
            VerticalAlignment="Center"
            Style="{StaticResource SecondaryCaptionLabelStyle}"
            Typography.NumeralAlignment="Tabular" />
    </Grid>
</UserControl>
