<UserControl
    x:Class="Gnome_Music_WinUI.Controls.CoverArt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    IsTabStop="False">

    <!-- A thin stroke outlines the art (Fluent uses strokes, not shadows, on surfaces);
         without art a neutral fill and a tertiary glyph stand in for it. -->
    <Border
        x:Name="Root"
        Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <FontIcon
                x:Name="PlaceholderIcon"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE8D6;" />
            <Image
                x:Name="ArtImage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                Stretch="UniformToFill">
                <Image.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Image.OpacityTransition>
            </Image>
        </Grid>
    </Border>
</UserControl>
