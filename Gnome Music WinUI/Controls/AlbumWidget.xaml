<UserControl
    x:Class="Gnome_Music_WinUI.Controls.AlbumWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnome_Music_WinUI.Controls"
    xmlns:h="using:Gnome_Music_WinUI.Helpers"
    xmlns:models="using:Gnome_Music_WinUI.Models">

    <!-- AlbumWidget.ui: AdwClamp(1000) with margins 48 -->
    <StackPanel Margin="0,48">
        <!-- albumInfo: cover and details, spacing 32 -->
        <Grid ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:CoverArt
                x:Name="Cover"
                VerticalAlignment="Center"
                Radius="8"
                Size="256" />
            <StackPanel
                x:Name="Details"
                Grid.Column="1"
                Margin="0,18,0,0"
                VerticalAlignment="Top">
                <TextBlock
                    x:Name="TitleText"
                    Margin="0,0,0,18"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource TitleLabelStyle}" />
                <TextBlock
                    x:Name="ArtistText"
                    Margin="0,0,0,12"
                    Style="{StaticResource SubtitleLabelStyle}" />
                <TextBlock
                    x:Name="ReleasedText"
                    Margin="0,0,0,12"
                    Style="{StaticResource SecondaryLabelStyle}" />
                <TextBlock
                    x:Name="ComposerText"
                    Margin="0,0,0,12"
                    Style="{StaticResource SecondaryLabelStyle}"
                    Visibility="Collapsed" />
                <!-- Play: on the album page an accent button in the color of the cover
                     (the code sets the brushes of the Default (dark) and Light
                     dictionaries), in the artists pane a standard button -->
                <StackPanel
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        x:Name="PlayButton"
                        AutomationProperties.Name="{x:Bind h:Strings.Play}"
                        Click="OnPlayClick"
                        Style="{StaticResource LargeAccentIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind h:Strings.Play}">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemAccentColorLight2}" />
                                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Opacity="0.9" Color="{ThemeResource SystemAccentColorLight2}" />
                                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Opacity="0.8" Color="{ThemeResource SystemAccentColorLight2}" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemAccentColorDark1}" />
                                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Opacity="0.9" Color="{ThemeResource SystemAccentColorDark1}" />
                                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Opacity="0.8" Color="{ThemeResource SystemAccentColorDark1}" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorButtonTextColor}" />
                                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemColorButtonFaceColor}" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <FontIcon FontSize="16" Glyph="&#xF5B0;" />
                    </Button>
                    <Button
                        x:Name="MenuButton"
                        AutomationProperties.Name="{x:Bind h:Strings.Menu}"
                        Style="{StaticResource LargeIconButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Click="OnPlayClick" Text="{x:Bind h:Strings.MenuPlay}" />
                                <MenuFlyoutItem Click="OnFavoriteClick" Text="{x:Bind h:Strings.AddToFavoriteSongs}" />
                                <MenuFlyoutItem Click="OnAddToPlaylistClick" Text="{x:Bind h:Strings.AddToPlaylistEllipsis}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- _disc_list_box: one DiscBox per disc -->
        <ItemsControl
            x:Name="DiscList"
            Margin="0,48,0,0"
            IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:CoreDisc">
                    <controls:DiscBox Disc="{x:Bind}" SongActivated="OnSongActivated" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
